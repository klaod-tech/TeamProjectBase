{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", ".firebaserc", "team-board.claude-backup.html", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/team-board.html" }],
    "headers": [{ "source": "**", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }]
  }
}
