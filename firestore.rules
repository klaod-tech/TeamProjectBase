rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 로그인한 사람은 누구나 팀원으로 봐요.
    // 특정 팀원만 허용하려면 아래 줄을 이렇게 바꾸세요:
    //   return request.auth != null
    //       && request.auth.token.email in ['a@gmail.com', 'b@gmail.com'];
    function member() {
      return request.auth != null;
    }

    match /board/meta {
      allow read, write: if member();
    }

    match /cards/{cardId} {
      allow read, write: if member();

      match /messages/{msgId} {
        allow read: if member();
        // 이미지는 줄인 JPEG 문자열로 댓글 안에 들어가요. 너무 큰 건 막아요.
        allow create: if member() && request.resource.data.author == request.auth.uid
          && (!('img' in request.resource.data)
              || (request.resource.data.img is string && request.resource.data.img.size() <= 500000));
        // 카드를 지우면 딸린 대화도 같이 지우므로 삭제는 팀원 모두에게 열어 둬요.
        allow delete: if member();
      }
    }

    // 이름·사진과 접속 표시는 본인 것만 쓸 수 있어요.
    match /users/{uid} {
      allow read: if member();
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /presence/{uid} {
      allow read: if member();
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
